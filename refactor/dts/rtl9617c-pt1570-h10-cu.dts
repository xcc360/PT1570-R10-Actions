// SPDX-License-Identifier: GPL-2.0-only
//
// PT1570-H10-CU（联通版，机型串 PT1570-H10-C）板级 DTS —— Taurus 基线（2026-11-21）。
//
// 本文件基于上游 lyq1996/rtl9617c-openwrt @refactor Taurus 基线的
// rtl9617c-pt1500-h10-2p5g.dts，按 OpenWrt / 上游规范重写，摒弃旧 base
// 的 rtl9617c-tyfza1-2p5g.dts include 与 tyfza1 私有覆盖模型。
//
// 硬件事实（2026-11-14/15 真机 telnet + 原厂 mtd4 内嵌 DTB 逐节点核对）：
//   * RTL9617C / 256 MiB SPI-NAND / 512 MiB DDR4
//   * 1x2.5GE + 3xGE LAN：外置 RTL8221B 2.5G PHY（MDIO addr6, C22 001cc849）
//   * 双 PCIe WiFi6： PCIe0 10ec:c852（8852C, 5G）/ PCIe1 10ec:0192（8192XB, 2.4G）
//   * XGPON（WAN PPPoE VLAN 1101）
//   * flash 分区与上游 2p5g 基线逐项一致
//
// ★ refactor 基线的两点规范变化（相对旧 base DTS）：
//   1) 节点命名：&ni（非 &ni0）、&gpio0 扁平化、P6 走独立 &serdes
//      （phy-rtl9617c-serdes.c）+ phy-mode=2500base-x + realtek,hisgmii；
//      上游已验证此架构 2.5G 可用，摒弃 base 的 realtek,hsgmii + /etc/serdes/*.txt。
//   2) factory：DTS 内 ubi-volume-factory 的 nvmem-layout 声明 MAC/SN/wifi-cal，
//      驱动直读；摒弃旧 tyfza1-factory 运行时脚本模型。
//
// ★ WiFi 是净投入（refactor 上游主动删了 rtl9617c 的整个 PCIe/WiFi 子系统）：
//   PCIe 控制器节点在本文件 &{/soc} 自建（照 base dtsi 逐项校验地址/serdes/复位脚），
//   驱动由 scripts/refactor/overlay-wifi-pcie.sh 回移植到规范位置（OOT，不换上游 Taurus PCIe）。
//   ★ 2026-11-21 跟进 Taurus：SoC 层切 rtk-taurus.dtsi + gpio_bank0/2/3；
//     PCIe/global_config 仍用回移植资产，避免上游新 pcie-taurus.c 需要全套 reset/serdes 绑定。
//   ⚠️ 实机验证点：&serdes（2.5G P6 lane）与 pcie_controls（PCIe lane0/1/2）
//      共用 lane-ctrl/reset/power 等寄存器窗口，两套驱动按 bit 操作不同 lane，
//      理论上可共存；若实机出现 2.5G 与 WiFi 互相干扰，按实施记录的可回退方案处理。

/dts-v1/;

#include "rtk-taurus.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/ {
	model = "Youhua PT1570-H10-CU (1x2.5GE + 3xGE + WiFi6)";
	compatible = "youhua,pt1570-h10-cu", "realtek,rtl9617c";

	aliases {
		serial0 = &uart0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon console=ttyS0,115200n8 loglevel=7 clk_ignore_unused";
		rootdisk = <&ubi_rootdisk>;
		// ⛔ 不写 root= 覆盖：刷入态挂根由内核 CONFIG_MTD_ROOTFS_ROOT_DEV + fitblk 完成。
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		voip-vector@0 {
			reg = <0 0 0 0x1000>;
			no-map;
		};
		voip@2000000 {
			reg = <0 0x02000000 0 0x00300000>;
			no-map;
		};
		voip-ipc@2300000 {
			reg = <0 0x02300000 0 0x00100000>;
			no-map;
		};
		ddr-noncache@9000000 {
			reg = <0 0x09000000 0 0x01a50000>;
		};
		ddr-cache@bc48000 {
			reg = <0 0x0bc48000 0 0x10000>;
		};
		tz-smc@eeff000 {
			reg = <0 0x0eeff000 0 0x1000>;
			no-map;
		};
		tz@ffc0000 {
			reg = <0 0x0ffc0000 0 0x40000>;
		};
	};

	// 面板灯：逐脚取自联通原厂 mtd4 内嵌 DTB 的 rtk_gpio_led 节点，
	// 并与 U-Boot run#5 灯表同源。面板左→右：
	//   电源(11H) 注册(9L) 光信号(10L) [5G] [2.4G]
	//   千兆口4(0L) 千兆口3(1L) 千兆口2(3L) 2.5G口(4L)
	//   电话(12H) 宽带(2L) WPS(5H) USB(7H) USB1(6L)
	// 5G/2.4G/WPS 由 PCIe WiFi / 按钮驱动接管，固件不强行点灯。
	leds {
		compatible = "gpio-leds";

		internet {
			label = "LED_PPP_G";
			gpios = <&gpio_bank0 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		los {
			label = "LED_LOS";
			gpios = <&gpio_bank0 10 GPIO_ACTIVE_LOW>;
		};
		pon {
			label = "LED_PON";
			gpios = <&gpio_bank0 9 GPIO_ACTIVE_LOW>;
		};
		led_power: power {
			label = "LED_PWR_G";
			gpios = <&gpio_bank0 11 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		phone {
			label = "LED_FXS";
			gpios = <&gpio_bank0 12 GPIO_ACTIVE_HIGH>;
		};
		lan0 {
			label = "LED_EPHY0";
			gpios = <&gpio_bank0 4 GPIO_ACTIVE_LOW>;   /* 2.5G 口，PHY 硬件驱动可长灭 */
		};
		lan1 {
			label = "LED_EPHY1";
			gpios = <&gpio_bank0 3 GPIO_ACTIVE_LOW>;   /* 千兆口2 */
		};
		lan2 {
			label = "LED_EPHY2";
			gpios = <&gpio_bank0 1 GPIO_ACTIVE_LOW>;   /* 千兆口3 */
		};
		lan3 {
			label = "LED_EPHY3";
			gpios = <&gpio_bank0 0 GPIO_ACTIVE_LOW>;   /* 千兆口4 */
		};
		usb0 {
			label = "LED_USB0";
			gpios = <&gpio_bank0 7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "usbport";
		};
		usb1 {
			label = "LED_USB1";
			gpios = <&gpio_bank0 6 GPIO_ACTIVE_LOW>;
		};
		wps {
			label = "LED_WPS_G";
			gpios = <&gpio_bank0 5 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio_bank0 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	scl-gpios = <&gpio_bank2 4 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio_bank2 5 GPIO_ACTIVE_HIGH>;

	bosa0: optical-front-end@51 {
		compatible = "realtek,rtl9617c-bosa";
		reg = <0x51>;
		nvmem-cells = <&bosa_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&mdio {
	status = "okay";

	phy2: ethernet-phy@2 { reg = <2>; };
	phy3: ethernet-phy@3 { reg = <3>; };
	phy4: ethernet-phy@4 { reg = <4>; };

	// 外置 RTL8221B 2.5G PHY：MDIO addr6 C22。refactor 用 HisGMII +
	// serdes-option-mode=1（对齐上游 PT1500 已实机验证的 2.5G 正解架构）。
	phy_2p5g: ethernet-phy@6 {
		reg = <6>;
		realtek,hisgmii;
		realtek,serdes-option-mode = <1>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				label = "LED_8221B_P6_0";
				default-state = "on";
			};
			led@1 {
				reg = <1>;
				label = "LED_8221B_P6_1";
				default-state = "on";
			};
			led@2 {
				reg = <2>;
				label = "LED_8221B_P6_2";
				default-state = "on";
			};
		};
	};
};

&ni {
	nvmem-cells = <&base_mac 0>;
	nvmem-cell-names = "mac-address";
	status = "okay";

	ethernet-ports {
		port@1 {
			reg = <1>;
			label = "lan2";
			phy-mode = "internal";
			phy-handle = <&phy2>;
		};
		port@2 {
			reg = <2>;
			label = "lan3";
			phy-mode = "internal";
			phy-handle = <&phy3>;
		};
		port@3 {
			reg = <3>;
			label = "lan4";
			phy-mode = "internal";
			phy-handle = <&phy4>;
		};
		// P6 XGE MAC = 2.5G 口（netdev lan1），独立 serdes PHY。
		port@6 {
			reg = <6>;
			label = "lan1";
			phy-mode = "2500base-x";
			phy-handle = <&phy_2p5g>;
			phys = <&serdes>;
		};
	};
};

&pon {
	status = "okay";
	nvmem-cells = <&epon_mac 0>, <&pon_sn>;
	nvmem-cell-names = "mac-address", "pon-serial";
	realtek,optical-front-end = <&bosa0>;
	tx-disable-gpios = <&gpio_bank0 15 GPIO_ACTIVE_HIGH>;
	realtek,burst-polarity = <0>;
	realtek,los-invert = <0>;
	realtek,uni-ports = /bits/ 8 <3 2 1 0>;
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x200000>;
				read-only;
			};
			partition@280000 {
				label = "env";
				reg = <0x280000 0x40000>;
			};
			partition@2c0000 {
				label = "env2";
				reg = <0x2c0000 0x40000>;
			};
			partition@300000 {
				label = "static_conf";
				reg = <0x300000 0x40000>;
			};

			ubi_partition: partition@340000 {
				label = "ubi_device";
				reg = <0x340000 0xf5c0000>;
				compatible = "linux,ubi";
				// ⛔ 不可 read-only：否则 UBI 只读 attach、rootfs_data 建不出
				// overlay，sysupgrade 刷入态黑砖（旧 CU 第二版实测踩过）。
				// refactor 上游 dtsi 已不给 ubi 分区标 read-only，无需覆盖。

				volumes {
					ubi_rootdisk: ubi-volume-fit {
						volname = "fit";
					};

					ubi_factory: ubi-volume-factory {
						volname = "factory";

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							base_mac: mac-address@1000 {
								compatible = "mac-base";
								reg = <0x1000 0x6>;
								#nvmem-cell-cells = <1>;
							};

							mac_count: mac-count@1006 {
								reg = <0x1006 0x4>;
							};

							epon_mac: mac-address@1010 {
								compatible = "mac-base";
								reg = <0x1010 0x6>;
								#nvmem-cell-cells = <1>;
							};

							pon_sn: pon-serial@1020 {
								reg = <0x1020 0x10>;
							};

							device_sn: device-serial@1030 {
								reg = <0x1030 0x20>;
							};

							wifi_cal_radio0: wifi-calibration@2000 {
								reg = <0x2000 0x1000>;
							};

							wifi_cal_radio1: wifi-calibration@3000 {
								reg = <0x3000 0x1000>;
							};

							bosa_calibration: bosa-calibration@4000 {
								reg = <0x4000 0x400>;
							};

							bosa_olt_calibration: olt-calibration@4800 {
								reg = <0x4800 0x400>;
							};

							xtemp_calibration: xtemp-calibration@5000 {
								reg = <0x5000 0x1000>;
							};
						};
					};
				};
			};
		};
	};
};

&serdes {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&watchdog {
	reset-on-timeout;
	delay-reset = <134>;
	status = "okay";
};

// ---------------------------------------------------------------------------
// PCIe 控制器（WiFi 回移植）—— refactor dtsi 无 PCIe 节点，照 base dtsi
// 的 rtl9617c-tyfza1.dtsi 逐项重建。pcie_controls 的 reg 全保留（驱动按
// by-name ioremap，缺项会 probe 失败）；与 &serdes 重叠的 lane 控制寄存器
// 由两套驱动按 bit 操作不同 lane，实机验证共存性。
// ---------------------------------------------------------------------------
&{/soc} {
	// Taurus dtsi 删除了 rtl9617c 的 global_config syscon；
	// 我们回移植的 OOT PCIe PHY（phy-rtl9617c-pcie.c）仍按 phandle 读取它，补回。
	global_config: syscon@f43200c0 {
		compatible = "realtek,rtl9617c-global-config", "syscon";
		reg = <0 0xf43200c0 0 4>;
	};
	pcie_controls: pcie-controls@f4320098 {
		compatible = "realtek,rtl9617c-pcie-controls";
		reg = <0 0xf4320098 0 4>, <0 0xf43200a0 0 4>,
		      <0 0xf43200c4 0 0x14>, <0 0xf432036c 0 4>, <0 0xf432009c 0 4>,
		      <4 0xf433b000 0 0x1000>, <0 0xf4600000 0 0x1000>;
		reg-names = "core-reset", "phy-reset", "phy-control", "power", "usb-reset",
		            "sgmii-analog", "sgmii-serdes";
		realtek,global-config = <&global_config>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#phy-cells = <1>;
	};

	pcie0: pcie@f4325000 {
		status = "okay";
		compatible = "realtek,rtl9617c-pcie";
		reg = <0 0xf4325000 0 0x400>,
		      <0 0xa0000000 0 0x1000>,
		      <0 0xa0001000 0 0x2000>,
		      <0 0xa0300000 0 0x100000>,
		      <0 0xf4333000 0 0x2000>,
		      <0x0 0xf432c000 0x0 0x1c>;
		reg-names = "global", "dbi", "config", "atu", "serdes", "coherent-atu";
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 255>;
		linux,pci-domain = <0>;
		ranges = <0x81000000 0x0 0x0 0x0 0xa0003000 0x0 0x10000 0x82000000 0x0 0xa0400000 0x0 0xa0400000 0x0 0xfc00000>;
		dma-ranges = <0x02000000 0 0 0 0 0 0x20000000>;
		dma-coherent;
		interrupts = <0 42 4>;
		interrupt-names = "wrapper";
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie0_intc 0>,
		                <0 0 0 2 &pcie0_intc 1>,
		                <0 0 0 3 &pcie0_intc 2>,
		                <0 0 0 4 &pcie0_intc 3>;
		clocks = <&pcie_controls 0>;
		resets = <&pcie_controls 0>, <&pcie_controls 2>;
		reset-names = "core", "phy";
		phys = <&pcie_controls 0>;
		phy-names = "pcie";
		reset-gpios = <&gpio_bank3 5 1>;
		reset-delay-ms = <150>;
		num-lanes = <1>;
		realtek,controller-index = <0>;
		realtek,ddr-bytes = <0x20000000>;
		realtek,coherent-hi-addr = <4>;

		realtek,serdes-profile = "B";
		serdes-cfg-dataA = <
		 0x4 0xa855 0x18 0xa 0x20 0x3591 0x28 0x8670
		 0x2c 0xb90d 0x34 0xf71a 0x38 0x1000 0x74 0xda1f
		 0x80 0xd477 0x88 0x23 0x8c 0xb66 0x90 0x4f30
		 0xa0 0xf802 0xc0 0x55 0x24 0x500c 0x24 0x520c
		 0x104 0xa84a 0x118 0xa 0x120 0x3591 0x128 0x8650
		 0x12c 0xb90d 0x134 0xf71a 0x138 0x1000 0x174 0xda1f
		 0x180 0xd477 0x184 0x55aa 0x188 0x23 0x18c 0xb66
		 0x1a0 0xf802 0x1bc 0x3900 0x1c0 0x4a 0x124 0x500c
		 0x124 0x520c
		>;
		serdes-cfg-dataB = <
		 0x4 0xa855 0x8 0x60c6 0x18 0x1f 0x20 0x3591
		 0x28 0xf670 0x2c 0xa90d 0x34 0xf71a 0x38 0x1000
		 0x74 0xda1f 0x80 0xd477 0x88 0x23 0x8c 0xb66
		 0x90 0x4f30 0xa0 0xf802 0xc0 0x55 0xc8 0xf0f3
		 0x24 0x500c 0x24 0x520c 0x104 0xa84a 0x108 0x60c6
		 0x118 0x1f 0x120 0x3591 0x128 0xf670 0x12c 0xa90d
		 0x134 0xf71a 0x138 0x1000 0x174 0xda1f 0x180 0xd479
		 0x184 0x55aa 0x188 0x23 0x18c 0xb66 0x190 0x4f0c
		 0x1a0 0xf802 0x1bc 0x3900 0x1c0 0x4a 0x1c8 0xf0f3
		 0x124 0x500c 0x124 0x520c
		>;
		pcie0_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	pcie1: pcie@f4326000 {
		status = "okay";
		compatible = "realtek,rtl9617c-pcie";
		reg = <0 0xf4326000 0 0x400>,
		      <0 0xb0000000 0 0x1000>,
		      <0 0xb0001000 0 0x2000>,
		      <0 0xb0300000 0 0x100000>,
		      <0 0xf4335000 0 0x2000>,
		      <0x0 0xf432c100 0x0 0x1c>;
		reg-names = "global", "dbi", "config", "atu", "serdes", "coherent-atu";
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 255>;
		linux,pci-domain = <1>;
		ranges = <0x81000000 0x0 0x0 0x0 0xb0003000 0x0 0x10000 0x82000000 0x0 0xb0400000 0x0 0xb0400000 0x0 0xfc00000>;
		dma-ranges = <0x02000000 0 0 0 0 0 0x20000000>;
		dma-coherent;
		interrupts = <0 46 4>;
		interrupt-names = "wrapper";
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie1_intc 0>,
		                <0 0 0 2 &pcie1_intc 1>,
		                <0 0 0 3 &pcie1_intc 2>,
		                <0 0 0 4 &pcie1_intc 3>;
		clocks = <&pcie_controls 1>;
		resets = <&pcie_controls 1>, <&pcie_controls 3>;
		reset-names = "core", "phy";
		phys = <&pcie_controls 2>;
		phy-names = "pcie";
		reset-gpios = <&gpio_bank3 6 1>;
		reset-delay-ms = <50>;
		num-lanes = <1>;
		realtek,controller-index = <1>;
		realtek,ddr-bytes = <0x20000000>;
		realtek,coherent-hi-addr = <4>;

		realtek,serdes-profile = "B";
		serdes-cfg-dataA = <
		 0x4 0xa855 0x18 0xa 0x20 0x3591 0x28 0x8670
		 0x2c 0xb90d 0x34 0xf71a 0x38 0x1000 0x74 0xda1f
		 0x80 0xd477 0x88 0x23 0x8c 0xb66 0x90 0x4f30
		 0xa0 0xf802 0xc0 0x55 0x24 0x500c 0x24 0x520c
		 0x104 0xa84a 0x118 0xa 0x120 0x3591 0x128 0x8650
		 0x12c 0xb90d 0x134 0xf71a 0x138 0x1000 0x174 0xda1f
		 0x180 0xd477 0x184 0x55aa 0x188 0x23 0x18c 0xb66
		 0x1a0 0xf802 0x1bc 0x3900 0x1c0 0x4a 0x124 0x500c
		 0x124 0x520c
		>;
		serdes-cfg-dataB = <
		 0x4 0xa855 0x8 0x60c6 0x18 0x1f 0x20 0x3591
		 0x28 0xf670 0x2c 0xa90d 0x34 0xf71a 0x38 0x1000
		 0x74 0xda1f 0x80 0xd477 0x88 0x23 0x8c 0xb66
		 0x90 0x4f30 0xa0 0xf802 0xc0 0x55 0xc8 0xf0f3
		 0x24 0x500c 0x24 0x520c 0x104 0xa84a 0x108 0x60c6
		 0x118 0x1f 0x120 0x3591 0x128 0xf670 0x12c 0xa90d
		 0x134 0xf71a 0x138 0x1000 0x174 0xda1f 0x180 0xd479
		 0x184 0x55aa 0x188 0x23 0x18c 0xb66 0x190 0x4f0c
		 0x1a0 0xf802 0x1bc 0x3900 0x1c0 0x4a 0x1c8 0xf0f3
		 0x124 0x500c 0x124 0x520c
		>;
		pcie1_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};
};
