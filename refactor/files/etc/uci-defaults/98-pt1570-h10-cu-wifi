#!/bin/sh
# PT1570-H10-CU：hostapd 断流缓解 + WiFi 出厂默认固化（2026-11-17）。
#
# ★ 2026-11-21：HT mode 由 HE80 改 VHT80（wpad 缺 CONFIG_IEEE80211AX，HE 会触发
#   35 个 unknown configuration item -> 看门狗复位），与出厂 wireless 默认值保持一致。
#
# 两项：
#   1) 出厂 wireless conffile 已在 files/etc/config/wireless 固化为
#      HE80 + 非 DFS 信道(149) + psk2+ccmp（本轮 5G 诊断结论）：
#        - ch36+80MHz 踩 DFS，hostapd 反复 RADAR-DETECTED->AP-DISABLED，手机搜不到；
#        - sae-mixed/WPA3 不被 rtl_ax_ap 驱动支持（仅 CCMP），连不上。
#      本脚本只服务 sysupgrade 保留老配置的场景，做幂等固化。
#   2) skip_inactivity_poll=1 / disassoc_low_ack=0，避免省电终端被 deauth。

[ "$(board_name)" = "youhua,pt1570-h10-cu" ] || exit 0

if [ ! -f /etc/config/wireless ]; then
	command -v wifi >/dev/null 2>&1 && wifi config >/dev/null 2>&1
fi
[ -f /etc/config/wireless ] || { logger -t wifi-cu "no /etc/config/wireless, skip"; exit 0; }

changed=0

set_val() {
	vif=$1; key=$2; value=$3
	uci -q get "wireless.$vif" >/dev/null 2>&1 || return 0
	[ "$(uci -q get "wireless.$vif.$key" 2>/dev/null)" = "$value" ] && return 0
	uci -q set "wireless.$vif.$key=$value"
	changed=1
}

for vif in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-iface$/\1/p'); do
	set_val "$vif" skip_inactivity_poll 1
	set_val "$vif" disassoc_low_ack 0
	# 固化加密为 psk2+ccmp（规避驱动不支持的 SAE/WPA3）；仅在为 none/sae* 时纠正
	enc=$(uci -q get "wireless.$vif.encryption" 2>/dev/null)
	case "$enc" in
		''|none|sae|sae-mixed|psk-mixed|psk2+ccmp|psk2+tkip+ccmp)
			[ "$enc" = "psk2+ccmp" ] || { uci -q set "wireless.$vif.encryption=psk2+ccmp"; changed=1; }
			;;
	esac
done

# 5G radio：固化 VHT80 + 非 DFS 信道（channel 36 在 CN 域是 DFS，改 149）
for radio in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-device$/\1/p'); do
	band=$(uci -q get "wireless.$radio.band" 2>/dev/null)
	if [ "$band" = "5g" ]; then
		ch=$(uci -q get "wireless.$radio.channel" 2>/dev/null)
		case "$ch" in
			''|auto|36|40|44|48|52|56|60|64)
				uci -q set "wireless.$radio.channel=149"; changed=1 ;;
		esac
		[ "$(uci -q get "wireless.$radio.htmode" 2>/dev/null)" = "VHT80" ] || {
			uci -q set "wireless.$radio.htmode=VHT80"; changed=1; }
	fi
done

if [ "$changed" = "1" ]; then
	uci -q commit wireless
	logger -t wifi-cu "WiFi defaults: VHT80/ch149/psk2+ccmp, skip_inactivity_poll=1 applied"
fi

exit 0
