# PT1570-H10-CU 默认无线配置（refactor 基线；随固件出厂，disabled=0）
#
# 两颗 Realtek 射频（PCIe 双卡，枚举顺序与旧 base 一致）：
#   radio0 = RTL8852CE（PCIe0，5GHz）
#   radio1 = RTL8192XBE（PCIe1，2.4GHz）
# path 与内核 PCIe 枚举一致；换 U-Boot 版型后用 `wifi config` 重新生成。
#
# ★ 2026-11-21 追加：wpad 缺 CONFIG_IEEE80211AX（含 MLD/WiFi7 但无 AX），
#   HE80/HE20 会让 hostapd 生成 ieee80211ax/he_* 共 35 个未知项 -> add_iface 失败
#   -> 看门狗复位。故 htmode 由 HE80/HE20 降为 VHT80/VHT20（802.11ac，wpad 支持）。
#
# ★ 2026-11-17 5G 故障诊断结论固化（本分支核心 WiFi 修复之一）：
#   - 5G 从 HE80 + ch36（CN 域 DFS）改为 ch149（非 DFS，手机兼容性最好）：
#     ch36+80MHz 触发 hostapd 反复 RADAR-DETECTED->AP-DISABLED (CSA not
#     supported)，beacon 时有时无 -> "搜不到"；固定 149 后 beacon 稳定。
#   - 加密从 sae-mixed/WPA3 改为 psk2+ccmp：rtl_ax_ap 驱动仅支持 CCMP，
#     set_key 对非 CCMP 返回 -EOPNOTSUPP -> "连不上"。
#   - 保留 skip_inactivity_poll / disassoc_low_ack 断流缓解。
#   sysupgrade 保留老配置时由 98-pt1570-h10-cu-wifi 幂等纠正。
#
# 默认开放式（无密码）：刷入后到 LuCI「网络→无线」设 WPA2 密码，
# 设密码时保持 WPA2-PSK/CCMP（不要用 WPA3/SAE）。

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/f4325000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option channel '149'
	option htmode 'VHT80'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'PT1570-H10-CU-5G'
	option encryption 'none'
	option skip_inactivity_poll '1'
	option disassoc_low_ack '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/f4326000.pcie/pci0001:00/0001:00:00.0/0001:01:00.0'
	option band '2g'
	option channel '1'
	option htmode 'VHT20'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'PT1570-H10-CU-2.4G'
	option encryption 'none'
	option skip_inactivity_poll '1'
	option disassoc_low_ack '0'
