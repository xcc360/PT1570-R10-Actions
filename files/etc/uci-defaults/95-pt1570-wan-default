#!/bin/sh
# PT1570-R10：出厂默认 WAN = pon0.<wan_vlan>（8021q）+ PPPoE，并打开 PON 转发引擎。
#
# 2026-11-11 真机（run15 initramfs + 移动 XGPON 线路）实证：
#   1) WAN 必须打 VLAN 标签：untagged pon0 连 PADO 都收不到；
#      pon0.1101 → PADI/PADO/PADR/PADS 全部正常。
#   2) 仅 VLAN 还不够：上游 90 脚本把 pon.pon.offload 设为 0（FE 关闭）后，
#      单播上行帧被静默丢弃（netdev 记 TX，PON MAC tx 不增长），
#      表现就是 PADS 之后 LCP ConfReq 连发无任何回应 → "Modem hangup"。
#      打开 FE（fe enabled=1 prepared=1）后同一份配置立刻 PAP 认证通过、
#      IPCP 拿到 100.125.x.x，IPv4/IPv6 全部正常。
#   3) 因此 FE 不是"可选加速"，而是当前驱动软件路径下单播可用的前提。
#
# 上游 target/linux/rtl9617c/base-files/etc/uci-defaults/90-tyfza1-pon-wan
# 照抄原厂 PT1500 的 EPON 布局（wan_vlan 3961 + offload 0），与本机不符，
# 本脚本在其之后（uf 文件名序 90 -> 95）覆盖为 R10 的实际布局。
#
# 边界：只在相关项仍是上游默认值时动手，用户/其他脚本写过的值一律不碰。
# 凭据（username/password）保持为空，必须由用户填写。
#
# 执行顺序：uci-defaults 按文件名排序，90（上游）-> 95（本脚本）-> 99（本机兜底）。
# 脚本跑完由 rc 删除，不会重复生效；sysupgrade 保留配置时也不会再跑。

[ "$(board_name)" = "youhua,pt1570-r10" ] || exit 0

changed=0

# ---- 1. 上网 VLAN：上游默认 3961（EPON）-> R10 实测 1101 ----
wan_vlan=$(uci -q get pon.pon.wan_vlan)
case "$wan_vlan" in
  ''|3961)
    wan_vlan=1101
    uci -q set pon.pon.wan_vlan="$wan_vlan"
    uci -q set pon.pon.mode='xgpon'
    changed=1
    ;;
esac

vlan_dev="pon0.$wan_vlan"

# ---- 2. 8021q 设备（mtu 1500：PPPoE 底层口必须 ≥1500） ----
found=0
index=0
while uci -q get "network.@device[$index]" >/dev/null; do
  if [ "$(uci -q get "network.@device[$index].name")" = "$vlan_dev" ]; then
    found=1
    uci -q get "network.@device[$index].mtu" >/dev/null || {
      uci -q set "network.@device[$index].mtu=1500"; changed=1; }
    break
  fi
  index=$((index + 1))
done
if [ "$found" = "0" ]; then
  uci -q add network device >/dev/null
  # ⚠️ 这里不能给 uci 值加单引号：外层是双引号，内部的单引号会被 uci 当成值的一部分，
  #    netifd 拿到的就是带引号的 8021q，VLAN 设备建不出来。
  uci -q set "network.@device[$index].type=8021q"
  uci -q set "network.@device[$index].ifname=pon0"
  uci -q set "network.@device[$index].vid=$wan_vlan"
  uci -q set "network.@device[$index].name=$vlan_dev"
  uci -q set "network.@device[$index].mtu=1500"
  changed=1
fi

# ---- 3. WAN 接口：设备名 / 协议 / MTU ----
wan_dev=$(uci -q get network.wan.device)
[ -n "$wan_dev" ] || wan_dev=$(uci -q get network.wan.ifname)
case "$wan_dev" in
  ''|pon0|pon0.3961|"$vlan_dev")
    uci -q set network.wan='interface'
    uci -q set network.wan.device="$vlan_dev"
    uci -q delete network.wan.ifname
    uci -q set network.wan.proto='pppoe'
    uci -q set network.wan.mtu='1492'
    uci -q set network.wan.ipv6='1'
    changed=1
    ;;
esac

# ---- 4. PON 转发引擎：单播上行必需 ----
if [ "$(uci -q get pon.pon.offload)" != "1" ]; then
  uci -q set pon.pon.offload='1'
  changed=1
fi
if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != "1" ]; then
  uci -q set firewall.@defaults[0].flow_offloading='1'
  changed=1
fi
if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != "1" ]; then
  uci -q set firewall.@defaults[0].flow_offloading_hw='1'
  changed=1
fi

if [ "$changed" = "1" ]; then
  uci -q commit network
  uci -q commit pon
  uci -q commit firewall
  logger -t pt1570-wan "default WAN -> $vlan_dev (pppoe), PON FE on"
fi

exit 0
