#!/bin/sh
# PT1570-R10：关闭 firewall 硬件流量卸载（flow_offloading_hw）。
#
# 背景（2026-11-19 WiFi 诊断）：
#   95-pt1570-wan-default 出于 PON FE 需求打开了 flow_offloading=1 和
#   flow_offloading_hw=1。但 RTL9617C 的 rtl_ax_ap WiFi 与硬件 flowtable
#   不兼容：真机 dmesg 每 ~5.7s 刷一次 "native TX BA ... operational"，
#   客户端反复 "deauthenticated due to inactivity"，iwinfo 信号值为 0。
#   上游 PonWRT-TYFZA1 issue #19/#25 也记录了硬件卸载导致 WiFi 断流。
#
# 本脚本只关硬件卸载，保留软件 flow_offloading=1（PON 单播上行仍需 FE）。
# 边界：只在 flow_offloading_hw 仍为 1（95 脚本默认）时才关闭；用户显式
# 设为 0 的不动；若用户明确想要硬件卸载可自行改回 1（保留手工入口）。
#
# 执行顺序：uci-defaults 按文件名排序，95（开 FE）-> 98（本脚本关 HW 卸载）
# -> 99（fit 兜底）。脚本跑完由 rc 删除，sysupgrade 保留配置时不再重跑。

[ "$(board_name)" = "youhua,pt1570-r10" ] || exit 0

changed=0

# 关闭硬件卸载；软件 flow_offloading 保持 1（pon.pon.offload / PON FE 不受影响）
if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
  uci -q set firewall.@defaults[0].flow_offloading_hw='0'
  changed=1
fi

# 双保险：确认软件卸载仍开（PON FE 单播上行必需，95 脚本已设，防御性补齐）
[ -n "$(uci -q get firewall.@defaults[0].flow_offloading)" ] || {
  uci -q set firewall.@defaults[0].flow_offloading='1'
  changed=1
}

if [ "$changed" = "1" ]; then
  uci -q commit firewall
  logger -t pt1570-wifi "hardware flow offload disabled (rtl_ax_ap WiFi compat); software offload kept"
fi

exit 0
