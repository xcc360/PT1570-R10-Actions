#!/bin/sh
# PT1570-R10：把原厂 hostapd / MIB 已开启的 WiFi 高级特性补进 OpenWrt 无线配置。
#
# 依据（2026-11-14 从 D:\ONT\PT1570-R10\BackUp-原厂 解包对比）：
#   /etc/conf/hostapd-backports.conf:
#       ieee80211ax=1, he_su_beamformer=1, he_su_beamformee=1,
#       he_mu_beamformer=1, wmm_enabled=1, rts/frag=-1
#   config.xml:
#       WLAN_LDPC_ENABLED=1, WLAN_STBC_ENABLED=1,
#       WLAN1_LDPC_ENABLED=1, WLAN1_STBC_ENABLED=1,
#       WLAN_AGGREGATION=1, WLAN_SHORTGI=1, WLAN_QoS=1
# 现用 OpenWrt 的 /etc/config/wireless 只有 band/channel/htmode/country，
# hostapd 全走保守默认，这是除 FEM 表之外第二处「不如原厂」的配置差。
#
# 安全性：/usr/share/ucode/wifi/hostapd.uc 会按驱动上报的 ht/vht/he cap
# 逐项回退（例如 he_phy_cap[3]&0x80 为 0 就强制 he_su_beamformer=false），
# 所以这里只「请求」能力，不会强开硬件不支持的功能；驱动不支持时自动忽略。
#
# 边界：只在选项缺失时补默认值，用户改过的一律不碰；country 保持 CN
#（原厂 hostapd 写 country_code=US，功率上限更宽，但改 regdomain 有合规
#  风险，不擅自跟随）。脚本跑完由 rc 删除；sysupgrade 保留配置时靠
#  files/etc/config/wireless 里同样带上的 option 兜底。

[ "$(board_name)" = "youhua,pt1570-r10" ] || exit 0

changed=0

# 只在值不存在时补；不覆盖 0/1 等用户显式设置
set_default() {
	radio=$1
	key=$2
	value=$3
	uci -q get "wireless.$radio" >/dev/null || return 0
	[ -z "$(uci -q get "wireless.$radio.$key")" ] || return 0
	uci -q set "wireless.$radio.$key=$value"
	changed=1
}

for radio in radio0 radio1; do
	# MIB: WLAN*_LDPC_ENABLED / WLAN*_STBC_ENABLED
	set_default "$radio" ldpc 1
	set_default "$radio" rxldpc 1
	set_default "$radio" tx_stbc 1
	set_default "$radio" rx_stbc 1

	# 原厂 hostapd-backports.conf 的 VHT/HE beamforming 全套
	set_default "$radio" su_beamformer 1
	set_default "$radio" su_beamformee 1
	set_default "$radio" mu_beamformer 1
	set_default "$radio" beamformer_antennas 2
	set_default "$radio" beamformee_antennas 2
	set_default "$radio" he_su_beamformer 1
	set_default "$radio" he_su_beamformee 1
	set_default "$radio" he_mu_beamformer 1
done

# ---- hostapd 断流缓解（2026-11-17，移植自 lu-1991 98-wifi-stability）----
# skip_inactivity_poll / disassoc_low_ack 是 wifi-iface（VAP）选项，不是 radio：
# 不主动轮询空闲终端、不因低 ACK 踢人，避免手机省电漏轮询被 deauth。
# 对所有 VAP 补，用户显式改过的值不覆盖（沿用 set_default 的"缺失才补"语义）。
for vif in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-iface$/\1/p'); do
	set_default "$vif" skip_inactivity_poll 1
	set_default "$vif" disassoc_low_ack 0
done

if [ "$changed" = "1" ]; then
	uci -q commit wireless
	logger -t pt1570-wifi "stock-grade LDPC/STBC/beamforming + hostapd inactivity/low-ack defaults applied"
fi

exit 0
