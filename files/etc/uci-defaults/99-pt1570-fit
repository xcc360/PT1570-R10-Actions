#!/bin/sh
# 首次开机 uci-defaults：出厂默认设置兜底 + 统一 UBI 方案 机型接线修正。
# 2026-11-09 起当前范围为 R10-only；H10 分支保留但标记为 DORMANT。
# 执行后系统自动删除本脚本。只改"仍是出厂默认值"的项，不覆盖用户自定义配置。
# 把 FORCE 改成 1 可强制覆盖时区与主机名。
#
# 不写 PON SN / MAC / LOID / WiFi 校准：这些在 8 MiB factory 静态卷里，
# 由 DTS 的 nvmem-layout 按固定偏移读取，属于设备数据，绝不进固件。

FORCE=0
TZ_NEW='<+08>-8'
ZONE_NEW='Asia/Shanghai'

case "$(board_name)" in
  youhua,pt1570-r10) HOST_NEW='PT1570-R10' ;;
  youhua,pt1570-h10) HOST_NEW='PT1570-H10' ;;
  *) HOST_NEW='' ;;
esac

# ---- 时区 / 主机名 / NTP（沿用 HG5585F-CT 已验证的"不覆盖用户值"策略） ----
cur_tz=$(uci -q get system.@system[0].timezone || true)
cur_host=$(uci -q get system.@system[0].hostname || true)

apply_tz=0
case "$cur_tz" in
  ''|GMT0|UTC|CST-8|'<+08>-8') apply_tz=1 ;;
esac
[ "$FORCE" = "1" ] && apply_tz=1
if [ "$apply_tz" = "1" ]; then
  uci -q set system.@system[0].timezone="$TZ_NEW"
  uci -q set system.@system[0].zonename="$ZONE_NEW"
fi

if [ -n "$HOST_NEW" ]; then
  case "$cur_host" in
    ''|ponwrt|OpenWrt|ImmortalWrt) uci -q set system.@system[0].hostname="$HOST_NEW" ;;
  esac
  [ "$FORCE" = "1" ] && uci -q set system.@system[0].hostname="$HOST_NEW"
fi

if uci -q get system.ntp.server | grep -qE 'time\.apple\.com|time1\.google\.com|time\.cloudflare\.com|pool\.ntp\.org'; then
  uci -q delete system.ntp.server
  uci -q set system.ntp.enabled='1'
  uci -q set system.ntp.enable_server='0'
  for s in ntp.aliyun.com time1.cloud.tencent.com ntp.ntsc.ac.cn cn.pool.ntp.org; do
    uci -q add_list system.ntp.server="$s"
  done
fi
uci -q commit system

# ---- 统一 UBI 方案：关闭 anon_mount ----
# 上游 95-pt1500-storage 只对 pt1500 的 board_name 生效。统一 UBI 方案 下只有
# fit（固件）与 rootfs_data（overlay）归 OpenWrt 所有；block-mount 的
# anon_mount 可能把残留的原厂 UBIFS 卷以 rw 挂上并重放日志，必须关掉。
case "$(board_name)" in
  youhua,pt1570-r10|youhua,pt1570-h10)
    [ "$(uci -q get fstab.@global[0].anon_mount)" = 0 ] || {
      uci -q set fstab.@global[0].anon_mount='0'
      uci -q commit fstab
    }
    ;;
esac

# ---- LAN 接线（新机型在 02_network 里没有 case，会落到默认分支） ----
# ⚠️ 2026-11-13 修正：此前注释"默认分支 lan1..lan4 与实测一致"是错的。
#    run24 真机 dmesg 4.33s 实证：rtl9617c-xram 原生 NI/DMA 驱动注册的
#    netdev 是 lan0 / lan2 / lan3 / lan4（"LAN port 0..3"），并打印
#    "LAN port 4 has no realtek,lan-phys; not registered"——系统里根本
#    没有 lan1。02_network 默认分支写死 lan1..lan4，导致 netdev lan0
#    （真实物理 RJ45，带独立 PHY）游离在 br-lan 之外：admin DOWN、
#    无 master、拿不到 DHCP、面板灯不亮。用户现象"网口不通 + 灯不亮"
#    即此。WAN 走 PON（pon0.1101），4 个 RJ45 全是 LAN，与默认分支的
#    WAN=pon0 一致，只有 LAN 口名单需要兜底修正。
# H10 分支（DORMANT，暂缓）：设备未上线，无真机数据，不要启用。
case "$(board_name)" in
  youhua,pt1570-r10)
    # br-lan ports：只在仍是默认接线 lan1..lan4 时替换为实测四口，
    # 用户自己改过 ports 则不覆盖。
    if [ "$(uci -q get network.@device[0].name 2>/dev/null)" = "br-lan" ] \
       && [ "$(uci -q get network.@device[0].ports 2>/dev/null)" = "lan1 lan2 lan3 lan4" ]; then
      uci -q delete network.@device[0].ports
      for p in lan0 lan2 lan3 lan4; do
        uci -q add_list network.@device[0].ports="$p"
      done
      uci -q commit network
    fi
    # LED_EPHY0 的 netdev trigger 默认绑在不存在的 lan1（恒灭），
    # 改绑 lan0。真机验证：改后该口插线即亮、tx/rx 闪烁正常。
    # LED_EPHY1/2/3 对 lan2/3/4 本来就对，不动。按 sysfs 匹配，
    # 不依赖上游生成的 section 名。
    idx=0
    while uci -q get system.@led[$idx] >/dev/null 2>&1; do
      if [ "$(uci -q get system.@led[$idx].sysfs 2>/dev/null)" = "LED_EPHY0" ] \
         && [ "$(uci -q get system.@led[$idx].dev 2>/dev/null)" = "lan1" ]; then
        uci -q set system.@led[$idx].dev='lan0'
        uci -q commit system
      fi
      idx=$((idx+1))
    done
    ;;
  youhua,pt1570-h10)
    # TODO(H10-DORMANT): 真机采集后按实际 netdev 名称补 ucidef_set_interfaces_lan_wan。
    ;;
esac

# 若通过 files/ 注入了自定义 nft 片段，开机后请执行一次 fw4 check
#（本机历史上 /etc/nftables.d/udp2raw-ttl.nft 与 mangle_postrouting 冲突导致整体无 NAT）。

exit 0
