#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# PT1500-H10 2.5G：补齐 refactor 丢弃的面板 LAN/USB 灯 trigger。
#
# 2026-11-18 实机回归（run#11 固件）：刷入后"只有电源灯亮"。根因两条：
#   1) 极性：原厂 DTB 11 盏灯 flags 全 0x00 (ACTIVE_HIGH)，上游 DTS 却把
#      PPP/LOS/PON/EPHY/USB 写成 ACTIVE_LOW，逻辑反了 —— 已由
#      scripts/apply-dts-leds-fix.sh 在编译期统一改为 ACTIVE_HIGH。
#   2) trigger：base 有 94/96-tyfza1-leds + init.d/tyfza1-leds 驱动
#      LAN/USB 灯，refactor 上游把它们全删了，board.d/01_leds 只剩 WAN 灯。
#      实机 uci show system 只有 led_wan；LED_EPHY*/USB*/FXS 全 trigger=none
#      bright=0，永远不亮。本脚本把 LAN 灯按实体口 netdev 补回来。
#
# 遵循 refactor/OpenWrt 规范（摒弃 tyfza1 私有命名，走标准 uci-defaults）：
#   - 文件名 93-*（在 95 WAN 脚本之前；uci-defaults 按名排序），
#   - 用 uci system.led_* 段 + 标准 netdev trigger，不引入私有服务。
#
# 网口映射（实机 2026-11-18 核实 + base 96-pt1500-leds 已验证结论）：
#   lan1 = 2.5G 口（NI port6），lan2/lan3/lan4 = 三个 GE 口。
#   LED_EPHY1 -> lan2, LED_EPHY2 -> lan3, LED_EPHY3 -> lan4
#   LED_EPHY0 无对应实体口（原厂 4 灯但本机只有 3 个 GE + PHY 自管的 2.5G），
#             停绑（trigger=none）避免误指示。
#   LED_USB0/LED_USB1：refactor 未编 ledtrig-usbport，无 usbport trigger 可用；
#             绑 netdev=br-lan 作活动指示兜底（有数据即闪）。
#   LED_FXS：无 FXS 业务（本固件无语音），保持 none，不误点亮。
#   LED_PON/LED_LOS：由上游 pon-leds.uc 按 PON 状态机驱动，本脚本不碰。
#   LED_PPP_G(led_wan)：01_leds 已绑 pppoe-wan，本脚本不碰。
#
# 幂等：只补缺失的段 / 纠正已知错误绑定；用户自定义 trigger/dev 一律不覆盖。
# sysupgrade 保留 system 配置时同样生效（config_generate 会跳过已存在的段）。

[ -x /usr/bin/board_name ] && bn=$(board_name 2>/dev/null)
[ -z "${bn:-}" ] && bn=$(grep -qa pt1500-h10 /proc/device-tree/compatible 2>/dev/null && echo youhua,pt1500-h10-2p5g)
case "$bn" in
  youhua,pt1500-h10-2p5g|youhua,pt1500-h10) : ;;
  *) exit 0 ;;
esac

changed=0

# 补一个 LED 段：仅当该段不存在时创建；存在则只在它还是"默认未绑定"时纠正。
# 参数: <section> <name> <sysfs-label> <dev>
add_or_fix_netdev_led() {
  local sect="$1" name="$2" label="$3" dev="$4"
  local sysfs trigger curdev
  sysfs=$(uci -q get "system.$sect.sysfs")
  trigger=$(uci -q get "system.$sect.trigger")
  curdev=$(uci -q get "system.$sect.dev")
  if [ -z "$sysfs" ]; then
    uci -q set "system.$sect=led"
    uci -q set "system.$sect.name=$name"
    uci -q set "system.$sect.sysfs=$label"
    uci -q set "system.$sect.trigger=netdev"
    uci -q set "system.$sect.dev=$dev"
    uci -q set "system.$sect.mode=link tx rx"
    changed=1
    return
  fi
  # 段已存在：只纠正"指向错误 dev 的默认 netdev 绑定"，不碰用户自定义 trigger
  if [ "$trigger" = "netdev" ] && [ -n "$curdev" ] && [ "$curdev" != "$dev" ]; then
    case "$curdev" in
      lan0|lan5|pon0*)  # 上游/旧固件的幽灵口，纠正回实体口
        uci -q set "system.$sect.dev=$dev"; changed=1 ;;
    esac
  fi
}

add_or_fix_netdev_led led_lan1 LAN2 LED_EPHY1 lan2
add_or_fix_netdev_led led_lan2 LAN3 LED_EPHY2 lan3
add_or_fix_netdev_led led_lan3 LAN4 LED_EPHY3 lan4
# USB 灯：refactor 无 usbport trigger，绑 br-lan 作活动兜底
add_or_fix_netdev_led led_usb USB LED_USB0 br-lan

# LED_EPHY0 无实体口：确保不误绑到幽灵口（若旧配置残留则清成 none）
if [ "$(uci -q get system.led_lan0.dev)" = "lan5" ] || \
   [ "$(uci -q get system.led_lan0.dev)" = "lan0" ]; then
  uci -q set system.led_lan0.trigger=none
  uci -q delete system.led_lan0.dev
  changed=1
fi

[ "$changed" = "1" ] && uci -q commit system
logger -t pt1500-h10-leds "panel LAN/USB LED netdev triggers (re)bound (refactor)"
exit 0
