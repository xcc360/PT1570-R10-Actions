#!/bin/sh
# 保证 apk 允许安装镜像仓库架构（2026-11-17 refactor 基线更新）
#
# refactor 基线编译架构已是 aarch64_cortex-a53（CPU_TYPE=cortex-a53），
# 镜像内 /etc/apk/arch 通常已含 aarch64_cortex-a53。本脚本做幂等补齐：
#   1. 若 /etc/apk/arch 缺失则跳过（避免误建错误架构文件）；
#   2. 若无 aarch64_cortex-a53 则补一行（防止后续镜像源切换架构被拒装）。
# base 旧基线的 a55 已被淘汰，这里不再追加 a53 做「跨架构通用」。
[ -f /etc/apk/arch ] || exit 0
grep -qx 'aarch64_cortex-a53' /etc/apk/arch || echo 'aarch64_cortex-a53' >> /etc/apk/arch
exit 0
