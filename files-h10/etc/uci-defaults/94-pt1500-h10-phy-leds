#!/bin/sh
# PT1500-H10 2.5G panel LED: replace force-on with a link/activity driver.
#
# 该灯不接 SoC GPIO，由 RTL8221B PHY 导出为
# /sys/class/leds/4f4329118.mdio:06:blue:lan。原实现强制 none+brightness=1
# 常亮；现改为由 /usr/bin/pt1500-2p5g-blink 按 lan1 链路+流量驱动，
# 行为与普通网口灯一致（插线亮/传数据闪/拔线灭）。
# 常驻进程交给 init.d 服务，本脚本仅首启注册并使能它。

[ -x /usr/bin/board_name ] && bn=$(board_name 2>/dev/null)
[ -z "${bn:-}" ] && bn=$(grep -qa pt1500-h10 /proc/device-tree/compatible 2>/dev/null && echo youhua,pt1500-h10-2p5g)
case "$bn" in
  youhua,pt1500-h10-2p5g|youhua,pt1500-h10) : ;;
  *) exit 0 ;;
esac

# 注册并立即启动常驻服务（init.d 负责开机自启）
/etc/init.d/pt1500-2p5g-blink enable 2>/dev/null
/etc/init.d/pt1500-2p5g-blink start 2>/dev/null

logger -t pt1500-phy-leds "RTL8221B 2.5G panel LED: link/activity driver enabled"
exit 0
