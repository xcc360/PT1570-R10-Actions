#!/bin/sh
# PT1500-H10 2.5G (RTL8221B PHY) panel LED driver.
#
# The 2.5G port has no SoC GPIO: its panel LED is exported by the RTL8221B PHY
# driver as /sys/class/leds/4f4329118.mdio:06:blue:lan.  That LED only reacts
# to link state (steady on/off); the netdev trigger's tx/rx activity blinking
# is NOT wired to the LED class device on this PHY.  So we drive brightness
# ourselves from lan1 carrier + rx/tx byte counters to mimic a normal port LED:
#   - link down        -> off
#   - link up, idle    -> steady on
#   - link up, traffic -> brief blink
LED=/sys/class/leds/4f4329118.mdio:06:blue:lan
NET=/sys/class/net/lan1
[ -e "$LED/brightness" ] || exit 0
printf 'none' > "$LED/trigger" 2>/dev/null
THRESH=1000
last_rx=$(cat "$NET/statistics/rx_bytes" 2>/dev/null); last_tx=$(cat "$NET/statistics/tx_bytes" 2>/dev/null)
while true; do
  carrier=$(cat "$NET/carrier" 2>/dev/null)
  if [ "$carrier" != "1" ]; then
    echo 0 > "$LED/brightness" 2>/dev/null
    sleep 0.2
    last_rx=$(cat "$NET/statistics/rx_bytes" 2>/dev/null); last_tx=$(cat "$NET/statistics/tx_bytes" 2>/dev/null)
    continue
  fi
  rx=$(cat "$NET/statistics/rx_bytes" 2>/dev/null); tx=$(cat "$NET/statistics/tx_bytes" 2>/dev/null)
  drx=$((rx - last_rx)); dtx=$((tx - last_tx))
  if [ "$drx" -ge "$THRESH" ] || [ "$dtx" -ge "$THRESH" ]; then
    echo 0 > "$LED/brightness" 2>/dev/null; sleep 0.08
    echo 1 > "$LED/brightness" 2>/dev/null
    last_rx=$rx; last_tx=$tx
    sleep 0.04
  else
    echo 1 > "$LED/brightness" 2>/dev/null
    sleep 0.1
  fi
done
