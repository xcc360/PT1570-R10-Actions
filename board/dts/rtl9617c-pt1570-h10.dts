//	external-phy-enable-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
// };
// &ni0 {
//	realtek,lan-phys = <&phy0 &phy1 &phy2 &phy3>;
//	/delete-property/ phys;
//	/delete-property/ phy-names;
// };
//
// TODO(UNVERIFIED): 按 U-Boot 板级文档的 GPIO 表覆盖 leds / gpio-keys。
