# 联通版 PT1570-H10-CU 专用 defconfig（基于 youhua-pt1570-h10-ct-2p5g）。
# 硬件为 RTL9617C / 1x2.5GE + 3xGE / 双 PCIe WiFi6，板级描述沿用
# CT-2P5G 的 desc-2p5g.c（.ports = "2.5GE + 3xGE"）。上游 main 已删除
# CT-4GE 的 defconfig / board json / desc，绝不能再用 _4GE target 符号；
# 差异只有 factory 卷尺寸：改为 8 MiB，与 OpenWrt DTS 的
# fpga-image@10000 (0x10000+0x7e0000=0x800000) 对齐，避免 64 KiB 卷越界。
# stock mtd0 用联通原厂备份，GPT/BL2/BL31 由 pack_boot.py 原样保留。
CONFIG_ARM=y
CONFIG_COUNTER_FREQUENCY=25000000
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_REALTEK=y
CONFIG_TEXT_BASE=0x04000000
CONFIG_SYS_MALLOC_LEN=0x2000000
CONFIG_SYS_MALLOC_F_LEN=0x4000
CONFIG_ENV_SOURCE_FILE="pt1570-h10-ct"
CONFIG_NR_DRAM_BANKS=2
CONFIG_ENV_SIZE=0x40000
CONFIG_ENV_OFFSET=0x280000
CONFIG_DM_GPIO=y
CONFIG_DEFAULT_DEVICE_TREE="rtl9617c-youhua-pt1570-h10-ct-2p5g"
CONFIG_SYS_LOAD_ADDR=0x10000000
CONFIG_ENV_OFFSET_REDUND=0x2C0000
CONFIG_IDENT_STRING=" PT1570-H10"
CONFIG_TARGET_YOUHUA_PT1570_H10_CT_2P5G=y
CONFIG_RTK_WEB_FAILSAFE=y
CONFIG_RTK_FACTORY_SIZE=0x800000
CONFIG_LTO=y
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_SYS_PBSIZE=1056
CONFIG_HUSH_PARSER=y
CONFIG_SYS_PROMPT="PT1570-CU# "
CONFIG_CMD_BOOTMENU=y
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_UNLZ4 is not set
# CONFIG_CMD_UNZIP is not set
CONFIG_CMD_GPIO=y
# CONFIG_CMD_LOADS is not set
CONFIG_CMD_MTD=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_HTTPD_DHCP_SERVER=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_HASH=y
CONFIG_CMD_SMC=y
CONFIG_CMD_UBI_RENAME=y
# CONFIG_CMD_UBIFS is not set
CONFIG_ENV_OVERWRITE=y
CONFIG_ENV_IS_IN_NAND=y
CONFIG_ENV_REDUNDANT=y
CONFIG_NET_LWIP=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_SYS_RX_ETH_BUFFER=8
CONFIG_BUTTON=y
CONFIG_BUTTON_GPIO=y
CONFIG_CORTINA_GPIO=y
CONFIG_LED=y
CONFIG_LED_GPIO=y
# CONFIG_MMC is not set
CONFIG_MTD=y
CONFIG_DM_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_CORTINA_SPI_NAND=y
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_RTL9617C_NI=y
CONFIG_PHY_REALTEK=y
CONFIG_DM_SERIAL=y
CONFIG_CORTINA_UART=y
CONFIG_LZMA_SIZE_OPTIMIZATION=y
