#!/bin/sh
# PT1570-H10-CU（联通版）：按真实 netdev 形态校正 br-lan。
#
# 旧版脚本假设 2.5G 口可能叫 lan5，于是「死等 lan5」再遍历 lan1..lan5。
# 第二版固件实测「只有网口2/3可用，2.5G 和网口4 均不可用」后重新定位：
#   * 上游 2p5g DTS 在 MDIO addr7 挂了不存在的 C45 PHY，且 lan-phys 的
#     port3 为空 -> 只注册 lan0(phantom)/lan2/lan3；
#   * 修正后的 CU DTS 用 phy@6 C22 + realtek,p6-phy，驱动 netdev 是
#       lan0 = NI port0 phantom（无 RJ45，绝不入桥）
#       lan1 = P6 XGE MAC / 2.5G 口
#       lan2 / lan3 / lan4 = 三个 GE 口（NI port 1..3）
#   * board.d/02_network 对 CU 的 board_name 走默认分支，本来就会写
#     lan1 lan2 lan3 lan4；但驱动可能晚于 uci-defaults 注册 netdev，
#     且 sysupgrade 保留旧配置时可能残留 lan5 / lan0，这里做一次幂等校正。
#
# 只动 bridge 的 ports 列表，不碰 WAN（pon0）、不覆盖用户自定义接口。
# 执行顺序：90 -> 91 -> 92 -> 95 -> 96(本脚本) -> 97(上游) -> 98(LED)。

[ "$(board_name)" = "youhua,pt1570-h10-cu" ] || exit 0

# 等 2.5G(lan1) 与最后一个 GE(lan4) 都被驱动注册，最多 15s
i=0
while [ "$i" -lt 15 ]; do
	[ -e /sys/class/net/lan1 ] && [ -e /sys/class/net/lan4 ] && break
	i=$((i + 1))
	sleep 1
done

# 找到真正的桥设备段（不假设 @device[0]，95 脚本可能已新增 pon0.1101）
br=""
j=0
while uci -q get "network.@device[$j].type" >/dev/null; do
	[ "$(uci -q get "network.@device[$j].type")" = "bridge" ] && { br="$j"; break; }
	j=$((j + 1))
done
[ -n "$br" ] || exit 0

ports=$(uci -q get "network.@device[$br].ports")
changed=0

# 剔除不该在桥里的 phantom：lan0（无 RJ45）、lan5（旧驱动形态）
for dev in lan0 lan5; do
	case " $ports " in
		*" $dev "*)
			uci -q del_list "network.@device[$br].ports=$dev"
			changed=1
			logger -t pt1570-h10-cu-lan "removed phantom $dev from br-lan"
			;;
	esac
done

# 2.5G + 三个 GE 全部入桥（只补实际存在的 netdev）
for dev in lan1 lan2 lan3 lan4; do
	[ -e "/sys/class/net/$dev" ] || continue
	case " $ports " in
		*" $dev "*) continue ;;
	esac
	uci -q add_list "network.@device[$br].ports=$dev"
	changed=1
	logger -t pt1570-h10-cu-lan "added $dev to br-lan"
done

[ "$changed" = "1" ] && uci -q commit network
exit 0
