# PT1570-H10-CU（联通版）默认无线配置（随固件出厂，disabled=0 直接可用）
#
# 两颗 Realtek 射频：
#   radio0 = RTL8852CE（PCIe0，5GHz，HE80）
#   radio1 = RTL8192XBE（PCIe1，2.4GHz，HE20）
# CU 实机两张卡枚举为 0000:01:00.0 (10ec:c852 / 5G) 与
# 0001:01:00.0 (10ec:0192 / 2.4G)，与 R10 相同，故 path 沿用。
# path 与内核枚举顺序一致；换固件或换 U-Boot 版型后如果 phy 顺序变了，
# 可以用 `wifi config` 重新生成，或按 `ls /sys/class/ieee80211/*/device` 核对。
#
# SSID 按「型号 + 频段」区分，不启用双频合一：
#   5GHz  -> PT1570-H10-CU-5G
#   2.4GHz -> PT1570-H10-CU-2.4G
# 由 scripts/set-band-ssids.py 依 band 生成并在 CI 断言，勿手动改回同名。
#
# 断流缓解（2026-11-17，移植自 lu-1991 的 R10 CI 仓库 98-wifi-stability）：
#   每个 VAP 带 skip_inactivity_poll=1 + disassoc_low_ack=0，
#   避免手机/平板省电漏轮询被 hostapd deauth（"连着连着掉线"）。
#   sysupgrade 保留配置时由 99-pt1570-h10-cu-wifi-stability 补同样两项。
#
# 默认开放式（无密码），刷入后请到 LuCI「网络 → 无线」自行设置 WPA2/WPA3 密码。
# 这是 conffile，sysupgrade 会保留，不会被固件升级覆盖。

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/f4325000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'PT1570-H10-CU-5G'
	option encryption 'none'
	option skip_inactivity_poll '1'
	option disassoc_low_ack '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/f4326000.pcie/pci0001:00/0001:00:00.0/0001:01:00.0'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'PT1570-H10-CU-2.4G'
	option encryption 'none'
	option skip_inactivity_poll '1'
	option disassoc_low_ack '0'
