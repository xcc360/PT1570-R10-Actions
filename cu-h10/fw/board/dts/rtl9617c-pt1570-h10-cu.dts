// SPDX-License-Identifier: GPL-2.0-only
//
// PT1570-H10-CU（联通版，机型串 PT1570-H10-C）板级 DTS。
//
// 硬件事实（2026-11-14 真机 telnet + su 只读采集、用户确认，2026-11-15
// 原厂 mtd4 内嵌 DTB 逐节点解析）：
//   * RTL9617C / 256 MiB SPI-NAND / 512 MiB DDR4
//   * 1x2.5GE + 3xGE LAN：外置 RTL8221B 2.5G PHY
//     （lsmod: extGphy + rtl8221b；CFG_ID_XGE_PORT_BIT_MAP=0x40，
//      CFG_ID_GE_PORT_BIT_MAP=0x1F；原厂 DTB ext_gphy
//      port_mapping_phyAddr = <6 6>；真机 MDIO "phy6: C22=001cc849"）
//   * 双 PCIe WiFi6：0000:01:00.0 10ec:c852 / 0001:01:00.0 10ec:0192
//     （rtk_wifi6 + cfg80211，/sys/class/ieee80211/phy0 + phy1）
//   * flash 分区与上游 2p5g 基线逐项一致：
//       boot 2M@0x0 / env 256K@0x280000 / env2 256K@0x2C0000 /
//       static_conf 256K@0x300000 / ubi_device 0xF5C0000@0x340000
//   * XGPON（omci_app -ps xgpon1），WAN PPPoE VLAN 1101
//
// 统一 UBI 部分（chosen.rootdisk / volname=fit / factory nvmem-layout /
// fpga-image@10000）全部由 rtl9617c-tyfza1.dtsi 提供；本文件只负责硬件差异。
//
// ⚠️ 必须 include 2p5g 板定义（4ge 是空壳，外置 PHY 完全不初始化）。
//    但上游 rtl9617c-tyfza1-2p5g.dts 是「天翼 TYFZA1 电信 2.5G 板」，
//    有两处与联通本机不符，必须在本文件覆盖回去，否则：
//      ① 面板灯全错：电信板用高号 GPIO 70/71/139/140 + 11/12/3/4，
//         联通机是低号 2/9/10/11/12/0/1/3/4/5/6/7。第二版固件实测
//         「电源灯始终不亮、网口灯错位」即由此而来（电源被指到 gpio0 70
//         低有效，而真实电源灯是 gpio0 11 高有效）。
//      ② 2.5G / 网口4 不可用：电信板在 MDIO addr 7 挂 C45 HSGMII PHY，
//         联通机 addr7 空（"phy7: C45 PMAPMD id1=65535 id2=65535"、
//         "MDIO device at address 7 is missing."），真实 RTL8221B 在
//         addr 6 且是 C22。旧 lan-phys = <&phy0 &phy1 &phy2 0 &phy4>
//         让 port3 空（"LAN port 3 has no realtek,lan-phys"）、port4
//         指向不存在的 phy4（"LAN4 initialization failed: -19"），
//         最终只注册 lan0/lan2/lan3 —— 用户看到的「只有网口2/3可用」。
//
// ⛔ 不要写 /chosen 的 root= 覆盖块 —— R10 run15~run22 实证：显式写
//    root=/dev/fitblk0 会让刷入态起不来（灯全灭、无 DHCP）。挂根由内核侧
//    CONFIG_MTD_ROOTFS_ROOT_DEV + fitblk 完成，不需要 bootargs 的 root=。
//
// 注意：不要写 /dts-v1/；被 include 的 .dts 已经带了该标记。

#include "rtl9617c-tyfza1-2p5g.dts"

/ {
	model = "Youhua PT1570-H10-CU (RTL9617C UBI, 1x2.5GE + 3xGE + WiFi6)";
	compatible = "youhua,pt1570-h10-cu", "tianyi,tyfza1-2p5g", "realtek,rtl9617c";

	/*
	 * 固件态面板灯 —— 逐脚取自联通原厂 mtd4 内嵌 DTB 的 rtk_gpio_led
	 * 节点（led-gpio = <0x28 pin polarity>，0x28 = gpio0），并与
	 * 2026-11-15 实机确认的 U-Boot run#5 灯表同源：
	 *
	 *   面板左→右：电源(11H) 注册(9L) 光信号(10L) [5G] [2.4G]
	 *              千兆口4(0L) 千兆口3(1L) 千兆口2(3L) 2.5G口(4L)
	 *              电话(12H) 宽带(2L) [WPS(5H)] USB(7H)
	 *
	 * 2.5G 口灯位由 RTL8221B PHY 硬件驱动（原厂 LED_8221B_P6_*），
	 * GPIO 4 那一路在 U-Boot / 固件里都可能长灭，符合用户实测
	 * 「5G / 2.4G / 2.5G口 / WPS 四盏长期不亮」。
	 * 上游 2p5g DTS 用 /delete-node/ usb0 删掉 USB 灯，这里重建。
	 */
	leds {
		internet { gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; };      /* 宽带 LED_PPP_G */
		los      { gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; };     /* 光信号 LED_LOS */
		pon      { gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; };      /* 注册 LED_PON */
		power {                                                 /* 电源 LED_PWR_G */
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		phone    { gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };    /* 电话 LED_FXS */
		lan0     { gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; };      /* 2.5G口 LED_EPHY0 */
		lan1     { gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; };      /* 千兆口2 LED_EPHY1 */
		lan2     { gpios = <&gpio0 1 GPIO_ACTIVE_LOW>; };      /* 千兆口3 LED_EPHY2 */
		lan3     { gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; };      /* 千兆口4 LED_EPHY3 */
		usb0 {                                                  /* LED_USB0 */
			label = "LED_USB0";
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "usbport";
		};
		usb1     { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; };      /* LED_USB1 */
		wps      { gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };     /* WPS LED_WPS_G */
	};
};

/*
 * 有线网口：改回联通机真实 MDIO / P6 形态。
 *
 * rtl9617c-xram 的 rtl_register_lans() 先按 port=0..4 遍历
 * realtek,lan-phys（port == realtek,port 时改用 phy-handle），再单独解析
 * "realtek,p6-phy" 注册 port 6；netdev 命名：
 *   port0 -> lan0（phantom，无 RJ45）  port1 -> lan2  port2 -> lan3
 *   port3 -> lan4                       port6 -> lan1（2.5G 口，P6 XGE MAC）
 * 因此 4 个 GE 通道必须占满 lan-phys 的 index 0..3，且必须有 p6-phy。
 * 参考 PT1500-H10-2p5g 已实机验证的 phy@6 C22 + P6 方案。
 */
&mdio {
	/*
	 * 电信 2p5g 在 addr 7 挂 C45 HSGMII PHY（label phy4）；联通机该地址
	 * 无器件。保留节点但置 status=disabled：既不注册、不报
	 * "MDIO device at address 7 is missing"，也避免 /delete-node/ 让
	 * 上游 &ni0 里的 &phy4 label 悬空导致 dtc 编译失败。
	 */
	ethernet-phy@7 {
		status = "disabled";
	};

	/* 外置 RTL8221B 2.5G PHY：MDIO addr 6，Clause 22（C22 ID 001cc849）。
	 * C45 路径读到的厂商寄存器视图不对，HiSGMII 初始化会打死铜线 link；
	 * 用 no-vendor-finish 跳过天翼板专有 a408/a412/a5d4 收尾，
	 * oem-sds-option 保持原厂 MMD30.0x697A = 0x0001 的 HiSGMII+SGMII 模式。
	 */
	phy_2p5g: ethernet-phy@6 {
		reg = <6>;
		realtek,hsgmii;
		realtek,no-vendor-finish;
		realtek,oem-sds-option;
	};
};

&ni0 {
	/* index 0 是 port0（走 phy-handle=&phy0，不占连接器）；
	 * index 1..3 = 三个 GE 网口 -> lan2/lan3/lan4。port4 无连接器，
	 * 留空让驱动跳过（S4 SGMII lane 不由 netdev 承载）。 */
	realtek,lan-phys = <&phy0 &phy1 &phy2 &phy3>;
	/* P6 XGE MAC 才是 2.5G 网口：驱动据此注册 netdev lan1 */
	realtek,p6-phy = <&phy_2p5g>;
	phys = <&pcie_controls 5>;
	phy-names = "sgmii";
};

/*
 * ubi_device 分区必须可写 —— 2026-11-14 联通 H10-CU 真机刷砖定位（关键）。
 *
 * 症状：CU 首版固件 sysupgrade 刷入 fit 卷后上电黑砖（灯全灭），但 U-Boot
 *   下内存启动 initramfs-recovery.itb 完全正常（可配置、可 PPPoE 拨号）。
 *   fit 卷本身没问题：fitblk 正确识别 config-1、映射 /dev/fit0，
 *   factory/fit/rootfs_data 三卷都在。
 *
 * 根因：上游 rtl9617c-tyfza1.dtsi 给 partition@340000(ubi_device) 也标了
 *   read-only；110-spinand-readonly.patch 在 spinand_probe 里据此清掉
 *   MTD_WRITEABLE。真机 dmesg 实证：
 *     "ubi0: MTD device 4 is write-protected, attach in read-only mode"
 *   UBI 以只读方式 attach，刷机后 rootfs_data 整卷 0xFF 无法被 mount_root
 *   格式化成 ubifs，overlay 建不出来，刷入态必然起不来。initramfs 的 rootfs
 *   在内存里、不依赖 rootfs_data，所以内存启动不受影响 —— 这正是「能拨号、
 *   刷入却黑砖」的分界。
 *
 * R10 DTS 早有同样的 &qspi 覆盖块（2026-11-12 真机定位）；CU 从 PT1500-H10
 *   派生时漏掉了它。这里只放开 ubi_device；boot/env/env2/static_conf 保持只读。
 * 绝不能删除本覆盖块，apply-board-h10-cu.sh 里有对应断言。
 */
&qspi {
	flash@0 {
		partitions {
			partition@340000 {
				/delete-property/ read-only;
			};
		};
	};
};
